# Addons: only our own (qn*) in the AddOns folder; third-party addons (Titan, Auctionator ...) sit
# next to them because WoW loads the folder through a junction, but do not belong in the repo
/AddOns/*
!/AddOns/qn*/
# Monitor data is machine-specific (generated by AddOns\qnViewPort\scripts), optional
/AddOns/qnViewPort/Monitors.lua
# Test environment: Node packages (npm install) and Blizzard GlobalStrings (globalstrings.mjs) are
# fetched on demand
/tests/node_modules/
/tests/GlobalStrings/*.lua
# Screenshot from tools\Get-Screen.ps1
/tools/screen.png
# Plans and working notes: in docs\plans, not in the repo (the folder itself stays via .gitkeep)
/docs/plans/*
!/docs/plans/.gitkeep
