<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- qnGatherer: pin templates of the world map (mixins in WorldMap.lua; MapCanvas calls OnLoad) -->
	<Frame name="qnGathererNodePinTemplate" mixin="qnGathererNodePinMixin" enableMouse="true" virtual="true">
		<Size x="12" y="12"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="qnGathererAreaPinTemplate" mixin="qnGathererAreaPinMixin" virtual="true">
		<Size x="64" y="64"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Area" file="Interface\AddOns\qnGatherer\Media\Area" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
